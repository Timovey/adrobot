KEITARO_URL=https://tlgk.host
KEITARO_API_KEY=your_api_key_here
# SQLite (default) or e.g. postgresql+psycopg://user:pass@localhost:5432/adrobot (pip install "psycopg[binary]")
DATABASE_URL=sqlite:///./data/adrobot.db
DEFAULT_DOMAIN_ID=1813
DEFAULT_GROUP_ID=10332
DEFAULT_TRAFFIC_SOURCE_ID=836
CAMPAIGN_NAME_PREFIX=test_timovey_
GOOGLE_REDIRECT_URL=https://www.google.com/
# Optional: when set, /api/* (except /api/health) requires
# "Authorization: Bearer <token>" or "X-API-Key: <token>"
ADROBOT_API_TOKEN=
# DEBUG logs every Keitaro request (method, path, status, duration; never the API key)
LOG_LEVEL=INFO
KEITARO_TIMEOUT_SECONDS=60
